<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>

        <%- include('../partials/header') %>

            <main class="auth-page">

                <section class="auth-container">

                    <div class="auth-left">
                        <p class="hero-tag">Editar perfil</p>
                        <h1>Actualizá tus datos</h1>
                        <p>
                            Modificá tu información personal y tu imagen de perfil.
                        </p>
                    </div>

                    <form class="auth-form" action="/users/profile?_method=PUT" method="POST"
                        enctype="multipart/form-data">

                        <h2>Editar perfil</h2>

                        <div class="form-group">
                            <label>Nombre</label>
                            <input type="text" name="firstName" value="<%= user.firstName %>">
                        </div>

                        <div class="form-group">
                            <label>Apellido</label>
                            <input type="text" name="lastName" value="<%= user.lastName %>">
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" name="email" value="<%= user.email %>">
                        </div>

                        <div class="form-group">
                            <label>Categoría</label>
                            <select name="category">
                                <option value="student" <%=user.category=='student' ? 'selected' : '' %>>Alumno</option>
                                <option value="teacher" <%=user.category=='teacher' ? 'selected' : '' %>>Profesor
                                </option>
                                <option value="admin" <%=user.category=='admin' ? 'selected' : '' %>>Admin</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Imagen actual</label>
                            <div class="profile-card">
                                <img src="/images/users/<%= user.image %>" alt="Imagen de perfil" class="profile-img">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Cambiar imagen</label>
                            <input type="file" name="image">
                        </div>

                        <button type="submit" class="btn-primary auth-btn">
                            Guardar cambios
                        </button>

                    </form>

                </section>

            </main>

            <%- include('../partials/footer') %>

    </body>

</html>