<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>

        <%- include('../partials/header') %>

            <main class="auth-page">

                <section class="auth-container">

                    <div class="auth-left">
                        <p class="hero-tag">Bienvenido nuevamente</p>
                        <h1>Ingresá a tu cuenta</h1>

                        <p>
                            Accedé a tus clases, historial de compras y profesores favoritos.
                        </p>
                    </div>

                    <form class="auth-form" action="/users/login" method="POST">

                        <h2>Iniciar sesión</h2>

                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" name="email" placeholder="Ingresá tu email">
                        </div>

                        <div class="form-group">
                            <label>Contraseña</label>
                            <input type="password" name="password" placeholder="Ingresá tu contraseña">
                        </div>

                        <div class="remember-row">
                            <label>
                                <input type="checkbox" name="remember">
                                Recordarme
                            </label>

                            <a href="#">Olvidé mi contraseña</a>
                        </div>

                        <button type="submit" class="btn-primary auth-btn">
                            Iniciar sesión
                        </button>

                        <p class="auth-link">
                            ¿No tenés cuenta?
                            <a href="/users/register">Registrate</a>
                        </p>

                    </form>
                </section>

            </main>

            <%- include('../partials/footer') %>

    </body>

</html>