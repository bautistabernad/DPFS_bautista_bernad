<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>

        <%- include('../partials/header') %>

            <main class="auth-page">

                <section class="auth-container">

                    <div class="auth-left">
                        <p class="hero-tag">Creá tu cuenta</p>
                        <h1>Sumate a Tempo</h1>
                        <p>
                            Registrate para comprar clases, guardar profesores favoritos y acceder a tu historial.
                        </p>
                    </div>

                    <form class="auth-form" action="/users/register" method="POST" enctype="multipart/form-data">

                        <h2>Registro</h2>

                        <div class="form-group">
                            <label>Nombre</label>
                            <input type="text" name="firstName" placeholder="Ingresá tu nombre"
                                value="<%= oldData.firstName ? oldData.firstName : '' %>">

                            <% if (errors.firstName) { %>
                                <small class="form-error">
                                    <%= errors.firstName.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Apellido</label>
                            <input type="text" name="lastName" placeholder="Ingresá tu apellido"
                                value="<%= oldData.lastName ? oldData.lastName : '' %>">

                            <% if (errors.lastName) { %>
                                <small class="form-error">
                                    <%= errors.lastName.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" name="email" placeholder="Ingresá tu email"
                                value="<%= oldData.email ? oldData.email : '' %>">

                            <% if (errors.email) { %>
                                <small class="form-error">
                                    <%= errors.email.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Contraseña</label>
                            <input type="password" name="password" placeholder="Creá una contraseña">

                            <% if (errors.password) { %>
                                <small class="form-error">
                                    <%= errors.password.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Categoría</label>
                            <select name="category">
                                <option value="student" <%=oldData.category=='student' ? 'selected' : '' %>>Alumno
                                </option>
                                <option value="teacher" <%=oldData.category=='teacher' ? 'selected' : '' %>>Profesor
                                </option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Imagen de perfil</label>
                            <input type="file" name="image">

                            <% if (errors.image) { %>
                                <small class="form-error">
                                    <%= errors.image.msg %>
                                </small>
                                <% } %>
                        </div>

                        <button type="submit" class="btn-primary auth-btn">
                            Crear cuenta
                        </button>

                        <p class="auth-link">
                            ¿Ya tenés cuenta?
                            <a href="/users/login">Iniciar sesión</a>
                        </p>

                    </form>

                </section>

            </main>

            <%- include('../partials/footer') %>
                <script src="/js/registerValidation.js"></script>
    </body>

</html>