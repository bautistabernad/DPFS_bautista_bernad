<!DOCTYPE html>
<html lang="es">


<%- include('./partials/head') %>

    <body>

        <%- include('./partials/header') %>

            <main>
                <section class="hero">
                    <div class="hero-content">
                        <p class="hero-tag">Clases en vivo · Packs pregrabados · Profesores verificados</p>
                        <h1>Aprendé música online <span>con profesores verificados</span></h1>
                        <p class="hero-text">Encontrá clases en vivo y packs pregrabados de guitarra, piano, canto,
                            batería y
                            más.</p>
                        <a href="productDetail.html" class="btn-primary">Explorar clases</a>
                    </div>
                </section>

                <section class="home-grid">
                    <div class="search-section">
                        <h2>¿Qué instrumento querés aprender?</h2>
                        <input type="text" placeholder="Buscar guitarra, piano, canto...">
                    </div>

                    <div class="categories">
                        <h2>Categorías populares</h2>
                        <div class="category-container">
                            <article class="category-card">🎸 Guitarra</article>
                            <article class="category-card">🎹 Piano</article>
                            <article class="category-card">🎤 Canto</article>
                            <article class="category-card">🥁 Batería</article>
                        </div>
                    </div>
                </section>

                <section class="benefits">
                    <h2>¿Por qué elegir Tempo?</h2>

                    <div class="benefit-container">
                        <article class="benefit-card">
                            <span>🛡️</span>
                            <div>
                                <h3>Profesores verificados</h3>
                                <p>Elegí docentes con experiencia y reseñas reales.</p>
                            </div>
                        </article>

                        <article class="benefit-card">
                            <span>📅</span>
                            <div>
                                <h3>Clases flexibles</h3>
                                <p>Reservá horarios que se adapten a tu rutina.</p>
                            </div>
                        </article>

                        <article class="benefit-card">
                            <span>▶️</span>
                            <div>
                                <h3>Packs para avanzar</h3>
                                <p>Comprá contenido pregrabado según tu nivel.</p>
                            </div>
                        </article>
                    </div>
                </section>

                <section class="products">
                    <h2>Profesores destacados</h2>

                    <div class="product-container">
                        <article class="product-card">
                            <div class="product-img">🎸</div>
                            <div>
                                <h3>Clase de Guitarra Inicial</h3>
                                <p>Profesor: Martín López</p>
                                <p>Nivel: Principiante</p>
                                <p class="price">$12.000</p>
                                <a href="productDetail.html" class="btn-secondary">Ver detalle</a>
                            </div>
                        </article>

                        <article class="product-card">
                            <div class="product-img">🎹</div>
                            <div>
                                <h3>Pack de piano moderno</h3>
                                <p>Profesora: Laura Gómez</p>
                                <p>Nivel: Intermedio</p>
                                <p class="price">$25.000</p>
                                <a href="productDetail.html" class="btn-secondary">Ver detalle</a>
                            </div>
                        </article>

                        <article class="product-card">
                            <div class="product-img">🎤</div>
                            <div>
                                <h3>Clase de técnica vocal</h3>
                                <p>Profesora: Sofía Ruiz</p>
                                <p>Nivel: Todos los niveles</p>
                                <p class="price">$15.000</p>
                                <a href="productDetail.html" class="btn-secondary">Ver detalle</a>
                            </div>
                        </article>
                    </div>
                </section>
            </main>

            <%- include('./partials/footer') %>

    </body>

</html>