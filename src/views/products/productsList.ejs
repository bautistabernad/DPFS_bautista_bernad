<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>

        <%- include('../partials/header') %>

            <main class="products">
                <h1 class="page-title">Clases y packs disponibles</h1>

                <div class="product-container">

                    <% products.forEach(product=> { %>

                        <article class="product-card">

                            <div class="product-img">🎵</div>

                            <div>
                                <h3>
                                    <%= product.name %>
                                </h3>

                                <p>
                                    <%= product.category %>
                                </p>

                                <p>
                                    <%= product.level %>
                                </p>

                                <p class="price">$<%= product.price %>
                                </p>

                                <a href="/products/<%= product.id %>" class="btn-secondary">
                                    Ver detalle
                                </a>
                                <a href="/products/<%= product.id %>/edit" class="btn-secondary">
                                    Editar
                                </a>
                                <form action="/products/<%= product.id %>?_method=DELETE" method="POST">
                                    <button type="submit" class="delete-btn">
                                        Eliminar
                                    </button>
                                </form>
                            </div>

                        </article>


                        <% }) %>


                </div>
            </main>

            <%- include('../partials/footer') %>

    </body>

</html>