<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>

        <%- include('../partials/header') %>

            <main class="auth-page">

                <section class="auth-container">

                    <div class="auth-left">
                        <p class="hero-tag">Panel administrador</p>
                        <h1>Editar producto</h1>

                        <p>
                            Modificá la información de una clase o pack publicado en Tempo.
                        </p>
                    </div>

                    <form class="auth-form" action="/products/<%= product.id %>?_method=PUT" method="POST"
                        enctype="multipart/form-data">

                        <h2>Editar producto</h2>

                        <div class="form-group">
                            <label>Nombre del producto</label>
                            <input type="text" name="name" value="<%= product.name ? product.name : '' %>">

                            <% if (errors.name) { %>
                                <small class="form-error">
                                    <%= errors.name.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Descripción</label>
                            <textarea
                                name="description"><%= product.description ? product.description : '' %></textarea>

                            <% if (errors.description) { %>
                                <small class="form-error">
                                    <%= errors.description.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Imagen actual</label>
                            <div class="edit-preview">🎸</div>
                        </div>

                        <div class="form-group">
                            <label>Cambiar imagen</label>
                            <input type="file" name="image">
                            <% if (errors.image) { %>
                                <small class="form-error">
                                    <%= errors.image.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Categoría</label>
                            <select name="categoryId">
                                <% categories.forEach(category=> { %>
                                    <option value="<%= category.id %>" <%=product.categoryId==category.id ? 'selected'
                                        : '' %>>
                                        <%= category.name %>
                                    </option>
                                    <% }) %>
                            </select>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Nivel</label>
                            <select name="level">
                                <option <%=product.level=='Principiante' ? 'selected' : '' %>>Principiante</option>
                                <option <%=product.level=='Intermedio' ? 'selected' : '' %>>Intermedio</option>
                                <option <%=product.level=='Avanzado' ? 'selected' : '' %>>Avanzado</option>
                                <option <%=product.level=='Todos los niveles' ? 'selected' : '' %>>Todos los niveles
                                </option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Precio</label>
                            <input type="number" name="price" value="<%= product.price ? product.price : '' %>">
                        </div>

                        <button type="submit" class="btn-primary auth-btn">
                            Guardar cambios
                        </button>

                    </form>

                </section>

            </main>

            <%- include('../partials/footer') %>
                <script src="/js/productValidation.js"></script>
    </body>

</html>