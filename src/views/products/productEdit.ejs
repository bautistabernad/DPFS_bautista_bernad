<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>

        <%- include('../partials/header') %>

            <main class="auth-page">

                <section class="auth-container">

                    <div class="auth-left">
                        <p class="hero-tag">Panel administrador</p>
                        <h1>Editar producto</h1>

                        <p>
                            Modificá la información de una clase o pack publicado en Tempo.
                        </p>
                    </div>

                    <form class="auth-form" action="/products/<%= product.id %>?_method=PUT" method="POST">

                        <h2>Editar producto</h2>

                        <div class="form-group">
                            <label>Nombre del producto</label>
                            <input type="text" name="name" value="<%= product.name %>">
                        </div>

                        <div class="form-group">
                            <label>Descripción</label>
                            <textarea name="description"><%= product.description %></textarea>
                        </div>

                        <div class="form-group">
                            <label>Imagen actual</label>
                            <div class="edit-preview">🎸</div>
                        </div>

                        <div class="form-group">
                            <label>Cambiar imagen</label>
                            <input type="text" name="image" value="<%= product.image %>">
                        </div>

                        <div class="form-group">
                            <label>Categoría</label>
                            <select name="category">
                                <option <%=product.category=='Guitarra' ? 'selected' : '' %>>Guitarra</option>
                                <option <%=product.category=='Piano' ? 'selected' : '' %>>Piano</option>
                                <option <%=product.category=='Canto' ? 'selected' : '' %>>Canto</option>
                                <option <%=product.category=='Batería' ? 'selected' : '' %>>Batería</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Nivel</label>
                            <select name="level">
                                <option <%=product.level=='Principiante' ? 'selected' : '' %>>Principiante</option>
                                <option <%=product.level=='Intermedio' ? 'selected' : '' %>>Intermedio</option>
                                <option <%=product.level=='Avanzado' ? 'selected' : '' %>>Avanzado</option>
                                <option <%=product.level=='Todos los niveles' ? 'selected' : '' %>>Todos los niveles
                                </option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Precio</label>
                            <input type="number" name="price" value="<%= product.price %>">
                        </div>

                        <button type="submit" class="btn-primary auth-btn">
                            Guardar cambios
                        </button>

                    </form>

                </section>

            </main>

            <%- include('../partials/footer') %>

    </body>

</html>