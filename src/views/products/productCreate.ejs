<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>

        <%- include('../partials/header') %>

            <main class="auth-page">

                <section class="auth-container">

                    <div class="auth-left">
                        <p class="hero-tag">Panel administrador</p>
                        <h1>Crear producto</h1>

                        <p>
                            Cargá nuevas clases o packs para publicar en Tempo.
                        </p>
                    </div>

                    <form class="auth-form" action="/products" method="POST" enctype="multipart/form-data">

                        <h2>Nuevo producto</h2>

                        <div class="form-group">
                            <label>Nombre del producto</label>
                            <input type="text" name="name" placeholder="Clase de guitarra"
                                value="<%= oldData.name ? oldData.name : '' %>">

                            <% if (errors.name) { %>
                                <small class="form-error">
                                    <%= errors.name.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Descripción</label>
                            <textarea name="description"
                                placeholder="Descripción del producto"><%= oldData.description ? oldData.description : '' %></textarea>

                            <% if (errors.description) { %>
                                <small class="form-error">
                                    <%= errors.description.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Imagen</label>
                            <input type="file" name="image">
                            <% if (errors.image) { %>
                                <small class="form-error">
                                    <%= errors.image.msg %>
                                </small>
                                <% } %>
                        </div>

                        <div class="form-group">
                            <label>Categoría</label>
                            <select name="categoryId">
                                <% categories.forEach(category=> { %>
                                    <option value="<%= category.id %>" <%=oldData.categoryId==category.id ? 'selected'
                                        : '' %>>
                                        <%= category.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Nivel</label>

                            <select name="level">
                                <option <%=oldData.level=='Principiante' ? 'selected' : '' %>>Principiante</option>
                                <option <%=oldData.level=='Intermedio' ? 'selected' : '' %>>Intermedio</option>
                                <option <%=oldData.level=='Avanzado' ? 'selected' : '' %>>Avanzado</option>
                                <option <%=oldData.level=='Todos los niveles' ? 'selected' : '' %>>Todos los niveles
                                </option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Precio</label>
                            <input type="number" name="price" placeholder="$"
                                value="<%= oldData.price ? oldData.price : '' %>">
                        </div>
                        <button type="submit" class="btn-primary auth-btn">
                            Crear producto
                        </button>

                    </form>

                </section>

            </main>

            <%- include('../partials/footer') %>
                <script src="/js/productValidation.js"></script>
    </body>

</html>