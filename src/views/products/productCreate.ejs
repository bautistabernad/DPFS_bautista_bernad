<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>

        <%- include('../partials/header') %>

            <main class="auth-page">

                <section class="auth-container">

                    <div class="auth-left">
                        <p class="hero-tag">Panel administrador</p>
                        <h1>Crear producto</h1>

                        <p>
                            Cargá nuevas clases o packs para publicar en Tempo.
                        </p>
                    </div>

                    <form class="auth-form" action="/products" method="POST" enctype="multipart/form-data">

                        <h2>Nuevo producto</h2>

                        <div class="form-group">
                            <label>Nombre del producto</label>
                            <input type="text" name="name" placeholder="Clase de guitarra">
                        </div>

                        <div class="form-group">
                            <label>Descripción</label>
                            <textarea name="description" placeholder="Descripción del producto"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Imagen</label>
                            <input type="file" name="image">
                        </div>

                        <div class="form-group">
                            <label>Categoría</label>
                            <select name="categoryId">
                                <% categories.forEach(category=> { %>
                                    <option value="<%= category.id %>">
                                        <%= category.name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Nivel</label>

                            <select name="level">
                                <option>Principiante</option>
                                <option>Intermedio</option>
                                <option>Avanzado</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Precio</label>
                            <input type="number" name="price" placeholder="$">
                        </div>
                        <button type="submit" class="btn-primary auth-btn">
                            Crear producto
                        </button>

                    </form>

                </section>

            </main>

            <%- include('../partials/footer') %>

    </body>

</html>