<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head') %>

    <body>
        <%- include('../partials/header') %>

            <main class="detail-page">

                <section class="detail-container">
                    <div class="detail-image">
                        🎸
                    </div>

                    <div class="detail-info">
                        <p class="hero-tag">
                            <%= product.category %> · <%= product.level %>
                        </p>
                        <h1>
                            <%= product.name %>
                        </h1>
                        <p class="detail-teacher">Profesor: Martín López</p>

                        <p class="detail-description">
                            <%= product.description %>
                        </p>

                        <div class="detail-data">
                            <span>Duración: 60 minutos</span>
                            <span>Modalidad: Online</span>
                            <span>Instrumento: <%= product.category %></span>
                        </div>

                        <p class="detail-price">
                            $<%= product.price %>
                        </p>

                        <div class="detail-actions">
                            <a href="/products/cart" class="btn-primary">Agregar al carrito</a>
                            <a href="/" class="btn-outline">Volver al inicio</a>
                        </div>
                    </div>
                </section>

                <section class="reviews">
                    <h2>Opiniones de estudiantes</h2>

                    <div class="review-container">
                        <article class="review-card">
                            <h3>Excelente clase</h3>
                            <p>Muy clara la explicación. Ideal para empezar desde cero.</p>
                        </article>

                        <article class="review-card">
                            <h3>Muy recomendable</h3>
                            <p>El profesor explica con paciencia y buenos ejemplos.</p>
                        </article>
                    </div>
                </section>

            </main>

            <%- include('../partials/footer') %>

    </body>

</html>